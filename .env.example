# Server-side only (never exposed to the browser). Copy to .env.local for dev
# and set in Vercel → Project → Settings → Environment Variables for prod.

# Dune API key — dune.com → Settings → API → Create API key
DUNE_API_KEY=

# Numeric ID of the saved realized-PnL query (create from dune/realized_pnl.sql)
DUNE_QUERY_ID=
